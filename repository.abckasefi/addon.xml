<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- plugin.video.abckasefi/repository.abckasefi/addon.xml -->
<addon id="repository.abckasefi" name="ABCKASEFI repository" version="1.0.1" provider-name="mirecekd">
  <extension point="xbmc.addon.repository" name="ABCKASEFI repository">
    <dir>
      <info compressed="false">BASE_URL_PLACEHOLDER/addons.xml</info>
      <checksum verify="sha256">BASE_URL_PLACEHOLDER/addons.xml.sha256</checksum>
      <datadir zip="true">BASE_URL_PLACEHOLDER/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Updates for the ABCKASEFI add-on</summary>
    <summary lang="cs_CZ">Aktualizace doplnku ABCKASEFI</summary>
